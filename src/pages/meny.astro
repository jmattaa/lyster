---
import Base from '../layouts/Base.astro';
---

<Base
  title="Menyn — Lyster"
  description="Lysters meny. Bläddra i menyn direkt på sidan eller ladda ner PDF."
>
  <section class="pb-[clamp(3rem,8vw,6rem)] pt-[clamp(2.5rem,6vw,5rem)]">
    <div class="mx-auto w-full max-w-shell px-gutter">
      <header class="mb-[clamp(2rem,4vw,3rem)]">
        <h1
          class="text-[clamp(3.8rem,8.5vw,7.5rem)] font-medium leading-[0.9] tracking-[-0.06em] text-balance"
        >
          Menyn
        </h1>
        <p class="mt-6 max-w-[42ch] text-[1.0625rem] leading-[1.65] text-ink-soft">
          Bläddra i menyn nedan. Du kan även
          <a
            class="underline decoration-gold/70 decoration-1 underline-offset-[0.22em] hover:decoration-gold"
            href="/meny.pdf"
            target="_blank"
            rel="noopener"
          >öppna eller ladda ner PDF:en</a>.
        </p>
      </header>

      <div class="w-full border border-ink/14 bg-paper-3 shadow-none">
        <object
          data="/meny.pdf#view=FitH"
          type="application/pdf"
          class="h-[85vh] min-h-[720px] w-full"
          aria-label="Lysters meny som PDF"
        >
          <iframe
            src="/meny.pdf#view=FitH"
            class="h-[85vh] min-h-[720px] w-full"
            title="Lysters meny"
            loading="lazy"
          ></iframe>
          <p class="p-6 text-ink-soft">
            Din webbläsare kan inte visa PDF:en inbäddad.
            <a
              class="underline decoration-gold/70 decoration-1 underline-offset-[0.22em] hover:decoration-gold"
              href="/meny.pdf"
              target="_blank"
              rel="noopener"
            >Ladda ner menyn här</a>.
          </p>
        </object>
      </div>
    </div>
  </section>
</Base>
