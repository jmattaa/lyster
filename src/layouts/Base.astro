---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Lyster — modern husmanskost i Stockholm',
  description = 'Lyster serverar modern husmanskost i Stockholm. Köttbullar med riktig gräddsås, stekt strömming och grönsaker från nära håll. Lunch och middag.',
  image = '/images/hero-rum-2400.webp',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://lysternorrmalm.se');
const ogImage = new URL(image, Astro.site ?? 'https://lysternorrmalm.se');
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e3a5f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Lyster" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <!--
      THESIS: Familiar Swedish dishes rebuilt as a precise editorial system — a full-bleed photograph of the room beside one cobalt plane. Refuses the dark, moody food-photo hero.
      OWN-WORLD: Warm beige paper, cobalt fields, gold rules; one authored mark; a full-bleed photograph band; one Swedish grotesk in monumental and whisper sizes; asymmetric editorial grid.
      STORY: This is husmanskost, sharpened. See the light, trust the craft, read the menu, book a table.
      FIRST VIEWPORT: Giant LYSTER logotype with a gold Y; a full-bleed cobalt-and-photo band carrying the promise, two actions, live open status, and the full address; the photograph holds the right side, the copy the left.
      GLYPHS: One authored mark only — the house mark. Everything else is type, photography, rule, and a real map.
      FORM: Plangeometrin, the dealt challenger chosen in the direction round (not a grounded-list position); seed key c255ad89.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#innehall">Hoppa till innehållet</a>
    <Header />
    <main id="innehall">
      <slot />
    </main>
    <Footer />

    <div class="mobile-book" aria-label="Snabb bokning">
      <p class="mobile-book__label"><strong>Boka bord</strong>Lunch &amp; middag</p>
      <div class="mobile-book__actions">
        <a class="btn btn--gold" href="#boka" data-booking-link>Boka bord</a>
        <a class="mobile-book__call" href="tel:+46812345678">Ring</a>
      </div>
    </div>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
