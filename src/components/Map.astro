---
const address = 'Luntmakargatan 42, 111 37 Stockholm';
const latitude = '59.3391975';
const longitude = '18.0618873';

const embedSrc = `https://www.openstreetmap.org/export/embed.html?bbox=18.0535%2C59.3345%2C18.0705%2C59.3440&layer=mapnik&marker=${latitude}%2C${longitude}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<figure class="find__map">
  <div class="find__map-frame">
    <iframe
      src={embedSrc}
      title={`Karta över Lyster på ${address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
  <figcaption class="find__caption">
    <span>Karta: <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a></span>
    <a class="link-underline" href={directionsHref} rel="noopener">Vägbeskrivning</a>
  </figcaption>
</figure>
