---
const mapsHref = 'https://www.google.com/maps/search/?api=1&query=Lystergr%C3%A4nd+4+Stockholm';
---

<figure class="find__map">
  <svg
    class="map"
    viewBox="0 0 720 540"
    role="img"
    aria-label="Illustrerad karta som visar Lyster vid korsningen Lystergränd och Storgatan, fyra minuter från tunnelbanan."
  >
    <rect width="720" height="540" fill="#eadfcb" />

    <g fill="#fbf7ee">
      <rect x="34" y="34" width="196" height="126" />
      <rect x="276" y="34" width="196" height="126" />
      <rect x="510" y="34" width="176" height="126" />
      <rect x="34" y="214" width="196" height="146" />
      <rect x="276" y="214" width="196" height="146" />
      <rect x="510" y="214" width="176" height="146" />
      <rect x="34" y="406" width="196" height="100" />
      <rect x="276" y="406" width="196" height="100" />
      <rect x="510" y="406" width="176" height="100" />
    </g>

    <g fill="#d9c8a8">
      <rect x="56" y="58" width="74" height="78" />
      <rect x="298" y="58" width="152" height="78" />
      <rect x="534" y="58" width="128" height="78" />
      <rect x="56" y="238" width="152" height="98" />
      <rect x="298" y="238" width="74" height="98" />
      <rect x="534" y="238" width="128" height="98" />
      <rect x="56" y="428" width="74" height="56" />
      <rect x="298" y="428" width="152" height="56" />
      <rect x="534" y="428" width="128" height="56" />
    </g>

    <g stroke="#1e3a5f" stroke-width="26" fill="none">
      <path d="M0 180H720" />
      <path d="M0 386H720" />
      <path d="M252 0V540" />
      <path d="M486 0V540" />
    </g>

    <g stroke="#f4eddf" stroke-width="2" opacity="0.6">
      <path d="M0 180H720" />
      <path d="M0 386H720" />
      <path d="M252 0V540" />
      <path d="M486 0V540" />
    </g>

    <path d="M486 180L252 386" stroke="#1e3a5f" stroke-width="13" fill="none" />
    <path d="M486 180L252 386" stroke="#f4eddf" stroke-width="1.5" opacity="0.55" fill="none" />

    <g fill="#1b1a17" font-family="Familjen Grotesk Variable, sans-serif" font-size="13" letter-spacing="2">
      <text x="52" y="164">STORGATAN</text>
      <text x="512" y="371">STORGATAN</text>
      <text x="268" y="510" transform="rotate(-90 268 510)">LYSTERGRÄND</text>
    </g>

    <g>
      <path d="M188 74C226 108 252 146 282 188" stroke="#a97e34" stroke-width="3" stroke-dasharray="7 8" fill="none" />
      <circle cx="180" cy="66" r="17" fill="#1e3a5f" />
      <text x="180" y="71" text-anchor="middle" fill="#fbf7ee" font-family="Familjen Grotesk Variable, sans-serif" font-size="13" font-weight="700">T</text>
      <text x="180" y="40" text-anchor="middle" fill="#4d483f" font-family="Familjen Grotesk Variable, sans-serif" font-size="11" letter-spacing="1.5">T-BANA</text>
    </g>

    <g transform="translate(300 188)">
      <circle r="34" fill="#fbf7ee" opacity="0.92" />
      <circle r="25" fill="#a97e34" />
      <rect x="-8" y="-8" width="16" height="16" fill="#1e3a5f" />
      <circle r="4" fill="#fbf7ee" />
    </g>

    <text x="344" y="183" fill="#1b1a17" font-family="Familjen Grotesk Variable, sans-serif" font-size="16" font-weight="700" letter-spacing="3">
      LYSTER
    </text>
    <text x="344" y="202" fill="#4d483f" font-family="Familjen Grotesk Variable, sans-serif" font-size="11" letter-spacing="1.2">
      LYSTERGRÄND 4
    </text>

    <g transform="translate(674 492)" fill="#1b1a17" font-family="Familjen Grotesk Variable, sans-serif" font-size="11" letter-spacing="1.5">
      <path d="M0 0V-26" stroke="#1b1a17" stroke-width="1.5" />
      <path d="M0-26L-7-14H7Z" fill="#1b1a17" />
      <text y="18" text-anchor="middle">N</text>
    </g>
  </svg>
  <figcaption class="find__caption">
    <span>Karta: illustration, inte skalenlig.</span>
    <a class="link-underline" href={mapsHref} rel="noopener">Öppna i kartor</a>
  </figcaption>
</figure>
