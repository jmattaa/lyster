---
const address = 'Luntmakargatan 42, 111 37 Stockholm';

const embedSrc =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2736.6743794196855!2d18.059317977501735!3d59.33924091022696!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x465f9d67d7ce6131%3A0xe2aac2620816f3b4!2sLuntmakargatan%2042%2C%20111%2037%20Stockholm!5e1!3m2!1sen!2sse!4v1792999526496!5m2!1sen!2sse';

const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<figure class="col-[1/6] mt-[clamp(2rem,4vw,3rem)] max-md:col-[1/13] print:hidden">
  <div class="relative aspect-[4/3] overflow-hidden border border-ink/18 bg-paper-2">
    <iframe
      class="block h-full w-full border-0 [filter:grayscale(0.18)_sepia(0.08)_saturate(0.78)_contrast(0.98)]"
      src={embedSrc}
      title={`Karta över Lyster på ${address}`}
      width="600"
      height="450"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <figcaption class="mt-[0.6rem] flex justify-between gap-4 text-[0.75rem] leading-[1.5] text-ink-soft max-sm:flex-wrap">
    <span>Karta: <a class="inline-block py-[0.3rem] underline decoration-1 underline-offset-[0.2em] hover:decoration-gold" href={mapHref} rel="noopener">Google Maps</a></span>
    <a class="inline-block py-[0.3rem] -my-[0.3rem] underline decoration-gold/70 decoration-1 underline-offset-[0.22em] hover:decoration-gold" href={directionsHref} rel="noopener">Vägbeskrivning</a>
  </figcaption>
</figure>
