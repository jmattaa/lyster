---
import Mark from './Mark.astro';
import Arrow from './Arrow.astro';

const pathname = Astro.url.pathname;
const onMenu = pathname.startsWith('/meny');
const homeHref = '/';

const btnNav =
  'group relative isolate ml-2 inline-flex min-h-[2.6rem] cursor-pointer items-center justify-center gap-3 overflow-hidden border-0 bg-cobalt px-[1.15rem] py-[0.7rem] text-[0.9rem] font-semibold leading-[1.1] tracking-[0.01em] text-paper-3 no-underline transition-[color] duration-[260ms] ease-brand before:absolute before:inset-0 before:-z-10 before:origin-left before:scale-x-0 before:bg-gold-bright before:transition-transform before:duration-[380ms] before:ease-brand hover:text-ink hover:no-underline hover:before:scale-x-100 active:translate-y-px max-md:hidden';
const brand = 'inline-flex min-h-11 flex-none items-center gap-[0.8rem] no-underline hover:no-underline';
const brandWord = 'text-[0.9rem] font-bold leading-none tracking-[0.235em]';
const dot = 'ml-[0.18em] inline-block h-[0.12em] w-[0.12em] -translate-y-[0.03em] bg-gold';
---

<header class="sticky top-0 z-50 border-b border-ink/14 bg-paper print:hidden">
  <div class="mx-auto flex min-h-[72px] w-full max-w-shell items-center justify-between gap-8 px-gutter max-md:min-h-16 print:w-full print:px-0">
    <a class={brand} href={homeHref} aria-label="Lyster — till startsidan">
      <Mark />
      <span class={brandWord} aria-hidden="true">L<span class="text-gold">Y</span>STER<span class={dot}></span></span>
    </a>

    <nav class="flex items-center gap-[clamp(1.25rem,2.5vw,2.5rem)] max-md:hidden" aria-label="Huvudmeny">
      <a
        class="relative py-[0.35rem] text-[0.95rem] no-underline after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-right after:scale-x-0 after:bg-gold after:transition-transform after:duration-[320ms] after:ease-brand hover:after:origin-left hover:after:scale-x-100 aria-[current=page]:after:origin-left aria-[current=page]:after:scale-x-100"
        href="/#om-oss">Om oss</a>
      <a
        class="relative py-[0.35rem] text-[0.95rem] no-underline after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-right after:scale-x-0 after:bg-gold after:transition-transform after:duration-[320ms] after:ease-brand hover:after:origin-left hover:after:scale-x-100 aria-[current=page]:after:origin-left aria-[current=page]:after:scale-x-100"
        href="/meny" aria-current={onMenu ? 'page' : undefined}>Menyn</a>
      <a
        class="relative py-[0.35rem] text-[0.95rem] no-underline after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-right after:scale-x-0 after:bg-gold after:transition-transform after:duration-[320ms] after:ease-brand hover:after:origin-left hover:after:scale-x-100 aria-[current=page]:after:origin-left aria-[current=page]:after:scale-x-100"
        href="/#hitta">Hitta hit</a>
    </nav>

    <div class="hidden items-center gap-[0.65rem] max-md:flex">
      <button
        class="inline-flex min-h-11 cursor-pointer items-center gap-[0.55rem] border border-ink/24 bg-transparent px-[0.9rem] py-[0.55rem] text-[0.85rem] font-semibold"
        type="button"
        aria-controls="mobilnav"
        aria-expanded="false"
        data-menu-open
      >
        <span class="grid w-[1.1rem] gap-1" aria-hidden="true"><span class="h-px bg-current"></span><span class="h-px bg-current"></span></span>
        Meny
      </button>
    </div>

    <a class={btnNav} href="#boka" data-booking-link>
      Boka bord
      <Arrow class="flex-none text-[1.0625rem] font-normal leading-none transition-transform duration-[380ms] ease-brand group-hover:translate-x-1" />
    </a>
  </div>
</header>

<dialog
  id="mobilnav"
  class="m-0 h-full max-h-none w-full max-w-none border-0 bg-cobalt p-0 text-paper-3 backdrop:bg-cobalt open:flex open:animate-nav-in open:flex-col"
  aria-label="Huvudmeny"
>
  <div class="flex min-h-[72px] items-center justify-between border-b border-paper-3/22 px-gutter max-md:min-h-16">
    <a class={brand} href="/" aria-label="Lyster — till startsidan">
      <Mark />
      <span class={brandWord} aria-hidden="true">L<span class="text-gold">Y</span>STER<span class={dot}></span></span>
    </a>
    <button
      class="inline-flex min-h-11 cursor-pointer items-center gap-2 border border-paper-3/35 bg-transparent px-3 py-2 text-[0.85rem] font-semibold text-paper-3"
      type="button"
      data-menu-close
    >
      Stäng
    </button>
  </div>
  <div class="flex flex-1 flex-col justify-between px-gutter pt-[clamp(2rem,6vh,4rem)] pb-[calc(2rem+env(safe-area-inset-bottom))]">
    <nav class="grid gap-[0.1rem]" aria-label="Mobilmeny">
      <a class="flex items-baseline justify-between border-b border-paper-3/18 py-[0.55rem] text-[clamp(2.2rem,9vw,4rem)] font-medium leading-[1.05] tracking-[-0.045em] text-paper-3 no-underline" href="/#om-oss">Om oss</a>
      <a class="flex items-baseline justify-between border-b border-paper-3/18 py-[0.55rem] text-[clamp(2.2rem,9vw,4rem)] font-medium leading-[1.05] tracking-[-0.045em] text-paper-3 no-underline" href="/meny">Menyn</a>
      <a class="flex items-baseline justify-between border-b border-paper-3/18 py-[0.55rem] text-[clamp(2.2rem,9vw,4rem)] font-medium leading-[1.05] tracking-[-0.045em] text-paper-3 no-underline" href="/#hitta">Hitta hit</a>
      <a class="flex items-baseline justify-between border-b border-paper-3/18 py-[0.55rem] text-[clamp(2.2rem,9vw,4rem)] font-medium leading-[1.05] tracking-[-0.045em] text-paper-3 no-underline" href="#boka" data-booking-link>Boka bord</a>
    </nav>
    <div class="mt-10 grid gap-4 text-[0.95rem] text-paper-3/78">
      <p><a class="text-paper-3 underline decoration-1 underline-offset-[0.2em] hover:decoration-gold" href="tel:+46812345678">08–123 45 678</a><br /><a class="text-paper-3 underline decoration-1 underline-offset-[0.2em] hover:decoration-gold" href="mailto:hej@lyster.se">hej@lyster.se</a></p>
      <p>Luntmakargatan 42<br />111 37 Stockholm</p>
      <p><a class="text-paper-3 underline decoration-1 underline-offset-[0.2em] hover:decoration-gold" href="https://instagram.com/lystersthlm" rel="noopener">@lystersthlm</a></p>
    </div>
  </div>
</dialog>
