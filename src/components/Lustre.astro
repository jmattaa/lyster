---
interface Props {
  animate?: boolean;
  class?: string;
}

const { animate = false, class: className } = Astro.props;
const uid = `lustre-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['lustre', animate && 'lustre--animate', className]}
  viewBox="0 0 600 600"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={`${uid}-disc`}>
      <circle cx="300" cy="300" r="266" />
    </clipPath>
    <clipPath id={`${uid}-upper`}>
      <path d="M -340 -340 H 340 V -6 H -340 Z" transform="translate(300 300) rotate(-38)" />
    </clipPath>
    <clipPath id={`${uid}-lower`}>
      <path d="M -340 6 H 340 V 340 H -340 Z" transform="translate(300 300) rotate(-38)" />
    </clipPath>
  </defs>

  <g clip-path={`url(#${uid}-disc)`}>
    <g class="lustre__half lustre__half--upper" clip-path={`url(#${uid}-upper)`}>
      <circle cx="300" cy="300" r="266" fill="var(--paper-3, #fbf7ee)" />
    </g>
    <g class="lustre__half lustre__half--lower" clip-path={`url(#${uid}-lower)`}>
      <circle cx="300" cy="300" r="266" fill="var(--gold-pale, #eed8a7)" />
    </g>

    <path
      class="lustre__glint"
      d="M 116.5 171.5 A 224 224 0 0 1 358 83.6"
      fill="none"
      stroke="var(--gold, #a97e34)"
      stroke-width="1"
      opacity="0.55"
    />
  </g>

  <circle
    class="lustre__rim"
    cx="300"
    cy="300"
    r="266"
    fill="none"
    stroke="var(--gold, #a97e34)"
    stroke-width="1"
    pathLength="1"
    opacity="0.6"
  />

  <g class="lustre__core">
    <circle cx="448" cy="412" r="104" fill="var(--cobalt-deep, #142a45)" />
    <circle
      cx="448"
      cy="412"
      r="104"
      fill="none"
      stroke="var(--gold, #a97e34)"
      stroke-width="2"
    />
    <circle cx="448" cy="412" r="22" fill="var(--gold-bright, #c49a4a)" />
  </g>
</svg>

<style>
  .lustre {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .lustre__half,
  .lustre__core {
    transform-box: fill-box;
  }

  .lustre__core {
    transform-origin: center;
  }

  :global(.js) .lustre--animate .lustre__half--upper {
    animation: lustre-focus-upper 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }

  :global(.js) .lustre--animate .lustre__half--lower {
    animation: lustre-focus-lower 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }

  :global(.js) .lustre--animate .lustre__core {
    animation: lustre-core 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  :global(.js) .lustre--animate .lustre__glint {
    animation: lustre-glint 1s ease 0.5s both;
  }

  :global(.js) .lustre--animate .lustre__rim {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: lustre-rim 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  @keyframes lustre-focus-upper {
    from {
      transform: translate(-9px, -11px);
    }
    to {
      transform: none;
    }
  }

  @keyframes lustre-focus-lower {
    from {
      transform: translate(9px, 11px);
    }
    to {
      transform: none;
    }
  }

  @keyframes lustre-core {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lustre-glint {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.55;
    }
  }

  @keyframes lustre-rim {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .lustre--animate .lustre__half--upper,
    :global(.js) .lustre--animate .lustre__half--lower,
    :global(.js) .lustre--animate .lustre__core {
      animation: none;
      opacity: 1;
      transform: none;
    }

    :global(.js) .lustre--animate .lustre__glint {
      animation: none;
      opacity: 0.55;
    }

    :global(.js) .lustre--animate .lustre__rim {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
