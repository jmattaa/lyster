---
import Mark from './Mark.astro';

const year = new Date().getFullYear();

const brand = 'inline-flex min-h-11 flex-none items-center gap-[0.8rem] no-underline hover:no-underline';
const brandWord = 'text-[0.9rem] font-bold leading-none tracking-[0.235em]';
const dot = 'ml-[0.18em] inline-block h-[0.12em] w-[0.12em] -translate-y-[0.03em] bg-gold';
const footerLink = 'inline-block py-[0.2rem] text-inherit no-underline hover:text-gold-pale';
---

<footer class="bg-ink pb-6 pt-[clamp(3.5rem,7vw,5.5rem)] text-paper-3 print:hidden">
  <div class="mx-auto w-full max-w-shell px-gutter print:w-full print:px-0">
    <div class="grid grid-cols-12 gap-[clamp(2rem,4vw,4rem)]">
      <div class="col-[1/4] max-lg:col-[1/5] max-md:col-[1/13]">
        <a class={brand} href="/" aria-label="Lyster — till startsidan">
          <Mark />
          <span class={brandWord} aria-hidden="true">L<span class="text-gold">Y</span>STER<span class={dot}></span></span>
        </a>
        <p class="mt-5 max-w-[22ch] text-[0.95rem] text-paper-3/68">Modern husmanskost i Stockholm. Svensk grund, europeiskt bord, samma handlag.</p>
      </div>

      <div class="col-span-3 max-md:col-span-6 max-sm:col-[1/13]">
        <h3 class="text-[0.72rem] font-semibold uppercase leading-none tracking-[0.16em] text-gold-pale">Kontakt</h3>
        <address class="mt-4 text-[0.9rem] not-italic leading-[1.65] text-paper-3/78">
          Luntmakargatan 42<br />
          111 37 Stockholm
        </address>
        <p class="mt-4 text-[0.9rem] leading-[1.65] text-paper-3/78">
          <a class={footerLink} href="tel:+46812345678">08–123 45 678</a><br />
          <a class={footerLink} href="mailto:hej@lyster.se">hej@lyster.se</a>
        </p>
      </div>

      <div class="col-span-2 max-md:col-span-6 max-sm:col-[1/13]">
        <h3 class="text-[0.72rem] font-semibold uppercase leading-none tracking-[0.16em] text-gold-pale">Öppettider</h3>
        <div class="mt-4 grid gap-[0.35rem] text-[0.9rem] text-paper-3/78">
          <div class="flex justify-between gap-4"><span>Tis–fre</span><span>11.30–23.00</span></div>
          <div class="flex justify-between gap-4"><span>Lör</span><span>12.00–23.00</span></div>
          <div class="flex justify-between gap-4"><span>Sön–mån</span><span>Stängt</span></div>
        </div>
      </div>

      <div class="col-span-2 max-md:col-span-6 max-sm:col-[1/13]">
        <h3 class="text-[0.72rem] font-semibold uppercase leading-none tracking-[0.16em] text-gold-pale">Följ</h3>
        <p class="mt-4 text-[0.9rem] leading-[1.65] text-paper-3/78">
          <a class={footerLink} href="https://instagram.com/lystersthlm" rel="noopener">Instagram</a><br />
          <a class={footerLink} href="/meny">Menyn</a><br />
          <a class={footerLink} href="#boka" data-booking-link>Boka bord</a>
        </p>
      </div>
    </div>

    <div class="mt-[clamp(3rem,6vw,5rem)] flex flex-wrap items-start justify-between gap-x-8 gap-y-4 border-t border-paper-3/18 pt-5 text-[0.72rem] leading-[1.55] text-paper-3/55 max-sm:flex-col">
      <p class="max-w-[54ch]">
        Skapad av <a class="underline decoration-1 underline-offset-[0.2em] hover:decoration-gold" href="https://github.com/jmattaa"><strong class="font-semibold text-gold-pale">Jonathan Matta</strong></a>
      </p>
      <p>© {year} Lyster</p>
    </div>
  </div>
</footer>
