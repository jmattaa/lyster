---
interface Props {
  animate?: boolean;
  class?: string;
}

const { animate = false, class: className } = Astro.props;
const uid = `plate-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['plate', animate && 'plate--animate', className]}
  viewBox="0 0 600 600"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={uid}>
      <circle cx="300" cy="300" r="280" />
    </clipPath>
  </defs>

  <g clip-path={`url(#${uid})`}>
    <circle cx="300" cy="300" r="280" fill="#fbf7ee" />
    <circle cx="300" cy="300" r="252" fill="none" stroke="#a97e34" stroke-width="1" opacity="0.32" />

    <g class="plate__food">
      <path
        d="M148 336C176 294 246 280 316 294C374 306 424 336 438 374C408 412 334 428 262 414C202 402 160 380 148 336Z"
        fill="#f1e3c3"
      />

      <g fill="#8a5a3b">
        <circle cx="258" cy="286" r="64" />
        <circle cx="360" cy="292" r="60" />
        <circle cx="308" cy="378" r="62" />
      </g>

      <g fill="#8c3a36">
        <circle cx="414" cy="330" r="13" />
        <circle cx="438" cy="358" r="11" />
        <circle cx="400" cy="372" r="10" />
        <circle cx="426" cy="392" r="12" />
        <circle cx="382" cy="392" r="8" />
      </g>

      <g fill="#6f7d40">
        <ellipse cx="206" cy="400" rx="34" ry="8" transform="rotate(-18 206 400)" />
        <ellipse cx="238" cy="416" rx="30" ry="7" transform="rotate(-8 238 416)" />
      </g>

      <g fill="#3f5f49">
        <path d="M306 166C316 194 316 220 306 242C296 220 296 194 306 166Z" />
        <path d="M298 212C284 210 274 200 270 186C286 186 297 194 302 206Z" />
        <path d="M314 200C328 196 338 186 341 172C325 173 314 182 309 194Z" />
      </g>
    </g>
  </g>

  <circle class="plate__ring" cx="300" cy="300" r="287" fill="none" stroke="#a97e34" stroke-width="2" pathLength="1" />
</svg>

<style>
  .plate {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .plate__ring {
    opacity: 0.88;
  }

  .plate__food {
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.js) .plate--animate .plate__ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: plate-ring 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  :global(.js) .plate--animate .plate__food {
    opacity: 0;
    animation: plate-settle 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.18s forwards;
  }

  @keyframes plate-ring {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes plate-settle {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .plate--animate .plate__ring {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }

    :global(.js) .plate--animate .plate__food {
      opacity: 1;
      animation: none;
    }
  }
</style>
