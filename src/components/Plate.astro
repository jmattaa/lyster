<style>
  .plate {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .plate__ring {
    opacity: 0.9;
  }

  .ingredient {
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.js) .plate--animate .plate__ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: plate-ring 1.35s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  :global(.js) .plate--animate .ingredient {
    opacity: 0;
    animation: plate-set 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) forwards;
  }

  @keyframes plate-ring {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes plate-set {
    from {
      opacity: 0;
      transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--rot, 0deg));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .plate--animate .plate__ring {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }

    :global(.js) .plate--animate .ingredient {
      opacity: 1;
      animation: none;
    }
  }
</style>
