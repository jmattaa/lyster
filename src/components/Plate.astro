---
interface Props {
  variant?: 'kottbullar' | 'stromming' | 'rotselleri' | 'ostkaka' | 'dryck' | 'tilltugg' | 'artsoppa';
  label?: string;
  animate?: boolean;
  decorative?: boolean;
  class?: string;
}

const {
  variant = 'kottbullar',
  label,
  animate = false,
  decorative = false,
  class: className,
} = Astro.props;

const uid = `plate-${Math.random().toString(36).slice(2, 8)}`;

const labels: Record<string, string> = {
  kottbullar: 'Köttbullar med gräddsås, lingon, pressgurka och potatispuré',
  stromming: 'Stekt strömming med potatispuré, brynt smör och dill',
  rotselleri: 'Ugnsbakad rotselleri med svamp, hasselnöt och brynt smör',
  ostkaka: 'Ostkaka med hjortronsylt och vispad grädde',
  dryck: 'Ett glas med guldgul dryck och is',
  tilltugg: 'Toast med räkor, löjrom och dill',
  artsoppa: 'Ärtsoppa med fläsk och senap',
};

const ariaLabel = label ?? labels[variant];
---

<svg
  class:list={['plate', animate && 'plate--animate', className]}
  viewBox="0 0 600 600"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : ariaLabel}
  focusable="false"
>
  {!decorative && <title>{ariaLabel}</title>}
  <defs>
    <clipPath id={uid}>
      <circle cx="300" cy="300" r="280" />
    </clipPath>
  </defs>

  <g clip-path={`url(#${uid})`}>
    <circle cx="312" cy="314" r="280" fill="#e1d3ba" />
    <circle cx="300" cy="300" r="280" fill="#fbf7ee" />
    <circle cx="300" cy="300" r="252" fill="none" stroke="#a97e34" stroke-width="1" opacity="0.38" />

    <g class="plate__food">
